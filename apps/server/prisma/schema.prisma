// Dino Park Tycoon - Database Schema
// 참조: docs/dino_park_technical_design.md, CLAUDE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// 유저 & 인증
// ========================================

model User {
  id            String   @id @default(cuid())
  tossId        String   @unique
  nickname      String
  level         Int      @default(1)
  exp           Int      @default(0)
  tutorialStep  Int      @default(0)
  lastLoginAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  park               Park?
  currency           Currency?
  greatFigures       UserGreatFigure[]
  storyProgress      StoryProgress[]
  characterAffinities CharacterAffinity[]
  storyFlags         StoryFlag[]
  explorations       Exploration[]
  hatchingQueue      HatchingQueue[]
  transactions       Transaction[]
  seasonPasses       SeasonPass[]

  // Social Relations
  friendsAsUser      Friend[]             @relation("FriendUser")
  friendsAsFriend    Friend[]             @relation("FriendTarget")
  sentFriendRequests FriendRequest[]      @relation("FriendRequestFrom")
  receivedFriendRequests FriendRequest[]  @relation("FriendRequestTo")
  intimacyAsUser     FriendIntimacy[]     @relation("IntimacyUser")
  intimacyAsFriend   FriendIntimacy[]     @relation("IntimacyFriend")
  visitsAsVisitor    ParkVisit[]          @relation("VisitVisitor")
  visitsAsHost       ParkVisit[]          @relation("VisitHost")
  guestbooksOwned    GuestBook[]          @relation("GuestBookOwner")
  guestbooksWritten  GuestBook[]          @relation("GuestBookVisitor")
  sentGifts          Gift[]               @relation("GiftSender")
  receivedGifts      Gift[]               @relation("GiftReceiver")
  socialNotifications SocialNotification[] @relation("NotificationUser")

  @@map("users")
}

// ========================================
// 재화
// ========================================

model Currency {
  id                    String   @id @default(cuid())
  userId                String   @unique
  gold                  Int      @default(10000)
  diamond               Int      @default(100)
  dna                   Int      @default(0)
  explorationEnergy     Int      @default(30)
  energyLastRechargedAt DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("currencies")
}

// ========================================
// 파크
// ========================================

model Park {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("My Dino Park")
  level     Int      @default(1)
  exp       Int      @default(0)
  gridSizeX Int      @default(20)
  gridSizeY Int      @default(20)
  isOpen Boolean @default(false)
  admissionCareCompleted Boolean @default(false)
  economySettledAt DateTime?
  onlineUntil DateTime?
  visitorRemainder Float @default(0)
  maintenanceRemainder Float @default(0)
  totalVisitors Int @default(0)
  totalAdmissionGold Int @default(0)
  firstVisitorsRewarded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dinosaurs Dinosaur[]
  dinosaurCollections DinosaurCollection[]
  buildings Building[]
  resourceInventory ResourceInventory[]
  productionJobs ProductionJob[]
  driveRuns DriveRun[]
  firstSynthesis FirstSynthesisJob?
  repeatSyntheses RepeatSynthesisJob[]
  growthClaims ParkGrowthClaim[]
  technologyResearch ParkTechnologyResearch[]

  @@map("parks")
}

model ParkGrowthClaim {
  parkId    String
  goalId    String
  xp        Int
  claimedAt DateTime @default(now())
  park      Park     @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@id([parkId, goalId])
  @@map("park_growth_claims")
}

model ParkTechnologyResearch {
  parkId       String
  technologyId String
  level        Int
  startedAt    DateTime @default(now())
  completesAt  DateTime
  park         Park     @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@id([parkId, technologyId, level])
  @@map("park_technology_research")
}

// ========================================
// 공룡
// ========================================

model Dinosaur {
  id               String   @id @default(cuid())
  parkId           String
  speciesId        String   // game-data 참조 (예: "triceratops")
  nickname         String?
  level            Int      @default(1)
  exp              Int      @default(0)
  happiness        Int      @default(100)
  hunger           Int      @default(0)
  intimacy         Int      @default(0)
  positionX        Int
  positionY        Int
  isInPark         Boolean  @default(true)
  competitiveStats Json?
  lastFedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@map("dinosaurs")
}

// 영구 수집 등록. 현재 보유 개체와 분리하여 방생 후에도 남는다.
model DinosaurCollection {
  id               String   @id @default(cuid())
  parkId           String
  speciesId        String
  firstCollectedAt DateTime @default(now())

  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@unique([parkId, speciesId])
  @@map("dinosaur_collections")
}

// ========================================
// 건물
// ========================================

model Building {
  id                    String         @id @default(cuid())
  parkId                String
  typeId                String         // game-data 참조 (예: "visitor_center")
  level                 Int            @default(1)
  positionX             Int
  positionY             Int
  status                BuildingStatus @default(ACTIVE)
  assignedGreatFigureId String?
  completesAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  productionJobs ProductionJob[]

  @@map("buildings")
}

enum BuildingStatus {
  CONSTRUCTING
  ACTIVE
  UPGRADING
}

// ========================================
// 위인
// ========================================

model UserGreatFigure {
  id                 String   @id @default(cuid())
  userId             String
  figureId           String   // game-data 참조 (예: "darwin")
  level              Int      @default(1)
  exp                Int      @default(0)
  assignedBuildingId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, figureId])
  @@map("user_great_figures")
}

// ========================================
// 스토리 진행
// ========================================

model StoryProgress {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  sceneId   String?
  completed Boolean  @default(false)
  choices   Json     @default("[]")
  effects   Json     @default("{}")  // 선택지 효과 누적
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("story_progress")
}

// ========================================
// 캐릭터 호감도
// ========================================

model CharacterAffinity {
  id          String   @id @default(cuid())
  userId      String
  characterId String   // jin, olivia, marco, thomas, etc.
  affinity    Int      @default(0)
  level       Int      @default(1)
  unlockedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("character_affinities")
}

// ========================================
// 스토리 플래그
// ========================================

model StoryFlag {
  id        String   @id @default(cuid())
  userId    String
  flagId    String
  value     Json     @default("true")
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flagId])
  @@map("story_flags")
}

// ========================================
// 탐험
// ========================================

model Exploration {
  id          String            @id @default(cuid())
  userId      String
  regionId    String
  status      ExplorationStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  rewards     Json?
  missionId   String?
  missionStep Int @default(0)
  createdAt   DateTime          @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@map("explorations")
}

enum ExplorationStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
}

model DriveRun {
  id String @id @default(cuid())
  parkId String
  activeSlot String? @unique
  missionId String
  seed Int
  sector Int @default(0)
  x Int @default(500)
  collected Int @default(0)
  damage Int @default(0)
  required Int
  status DriveRunStatus @default(RUNNING)
  reward Json
  sectorStartedAt DateTime @default(now())
  createdAt DateTime @default(now())
  claimedAt DateTime?
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  egg HatchingQueue?

  @@index([parkId, missionId, status])
  @@map("drive_runs")
}

enum DriveRunStatus {
  RUNNING
  REWARD
  FAILED
  CLAIMED
  ABANDONED
}

// ========================================
// 부화
// ========================================

model HatchingQueue {
  id          String   @id @default(cuid())
  userId      String
  eggType     String
  speciesId   String?
  startedAt   DateTime @default(now())
  completesAt DateTime
  completed   Boolean  @default(false)
  readyToStart Boolean @default(false)
  sourceExplorationId String? @unique
  sourceDriveId String? @unique
  claimedDinosaurId String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDrive DriveRun? @relation(fields: [sourceDriveId], references: [id], onDelete: SetNull)

  @@map("hatching_queue")
}

// ========================================
// 거래 기록
// ========================================

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  type         TransactionType
  currencyType String          // "gold", "diamond", "dna"
  amount       Int
  reason       String
  balanceAfter Int
  createdAt    DateTime        @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("transactions")
}

enum TransactionType {
  EARN
  SPEND
  PURCHASE
  REWARD
}

// ========================================
// 시즌 패스
// ========================================

model SeasonPass {
  id             String   @id @default(cuid())
  userId         String
  seasonId       String
  level          Int      @default(1)
  exp            Int      @default(0)
  isPremium      Boolean  @default(false)
  claimedRewards Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@map("season_passes")
}

// ========================================
// 소셜 - 친구
// ========================================

model Friend {
  id            String       @id @default(cuid())
  userId        String
  friendId      String
  status        FriendStatus @default(ACCEPTED)
  nickname      String?      // 친구에게 붙인 별명
  lastVisitedAt DateTime?    // 마지막 방문 시간
  giftSentAt    DateTime?    // 마지막 선물 발송 시간
  giftReceivedAt DateTime?   // 마지막 선물 수령 시간
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  user   User @relation("FriendUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friends")
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Relations
  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("friend_requests")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// ========================================
// 소셜 - 친밀도
// ========================================

model FriendIntimacy {
  id                        String   @id @default(cuid())
  userId                    String
  friendId                  String
  intimacyLevel             Int      @default(1)  // 1-10
  intimacyExp               Int      @default(0)
  totalGiftsSent            Int      @default(0)
  totalGiftsReceived        Int      @default(0)
  totalVisits               Int      @default(0)
  consecutiveInteractionDays Int     @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  user   User @relation("IntimacyUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("IntimacyFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friend_intimacy")
}

// ========================================
// 소셜 - 파크 방문
// ========================================

model ParkVisit {
  id                String    @id @default(cuid())
  visitorId         String
  hostId            String
  visitType         String    @default("friend")  // friend, random, featured
  duration          Int       @default(0)         // 방문 시간 (초)
  interactionsCount Int       @default(0)
  leftLike          Boolean   @default(false)
  leftComment       String?
  createdAt         DateTime  @default(now())

  // Relations
  visitor User @relation("VisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  host    User @relation("VisitHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([visitorId])
  @@map("park_visits")
}

model GuestBook {
  id            String   @id @default(cuid())
  parkOwnerId   String
  visitorId     String
  visitorNickname String
  message       String
  likeCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  parkOwner User @relation("GuestBookOwner", fields: [parkOwnerId], references: [id], onDelete: Cascade)
  visitor   User @relation("GuestBookVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([parkOwnerId])
  @@map("guest_books")
}

// ========================================
// 소셜 - 선물
// ========================================

model Gift {
  id          String     @id @default(cuid())
  senderId    String
  receiverId  String
  giftType    String     // daily, special, event, achievement
  giftItemId  String
  status      GiftStatus @default(PENDING)
  expiresAt   DateTime
  message     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  sender   User @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, status])
  @@index([senderId])
  @@map("gifts")
}

enum GiftStatus {
  PENDING
  CLAIMED
  EXPIRED
}

// ========================================
// 소셜 - 알림
// ========================================

model SocialNotification {
  id           String   @id @default(cuid())
  userId       String
  type         String   // friendRequest, friendAccepted, giftReceived, parkVisited, guestbookComment, rankingChange
  fromUserId   String?
  fromNickname String?
  message      String
  data         Json?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Relations
  user User @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("social_notifications")
}

// One inventory owns ordinary resources now and quality-bearing materials later.
model ResourceInventory {
  id String @id @default(cuid())
  parkId String
  material String
  quality Int @default(0)
  amount Int @default(0)
  updatedAt DateTime @updatedAt
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@unique([parkId, material, quality])
  @@map("resource_inventory")
}

// activeSlot is the facility ID while unclaimed; nullable unique keeps one live job.
model ProductionJob {
  id String @id @default(cuid())
  parkId String
  buildingId String
  activeSlot String? @unique
  material String
  lots Int
  quantity Int
  costGold Int
  startedAt DateTime @default(now())
  readyAt DateTime
  claimedAt DateTime?
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)
  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([parkId, buildingId])
  @@map("production_jobs")
}

model FirstSynthesisJob {
  parkId String @id
  parentIds String[]
  labId String
  startedAt DateTime @default(now())
  readyAt DateTime
  claimedAt DateTime?
  resultDinosaurId String?
  exhibitedAt DateTime?
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@map("first_synthesis_jobs")
}

model RepeatSynthesisJob {
  id               String   @id @default(cuid())
  parkId           String
  requestId        String
  activeSlot       String?  @unique
  focus            String
  parentIds        String[]
  sequence         Int
  attempt          Int
  successChance    Float
  success          Boolean
  traits           Json?
  refunds          Json
  startedAt        DateTime @default(now())
  readyAt          DateTime
  claimedAt        DateTime?
  resultDinosaurId String?

  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@unique([parkId, requestId])
  @@unique([parkId, sequence])
  @@map("repeat_synthesis_jobs")
}

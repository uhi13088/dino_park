# 서버 설정
PORT=4000
NODE_ENV=development

# 데이터베이스
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dino_park?schema=public"

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis (캐시)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional paid artwork provider for newly discovered in-game hybrid lineages.
HYBRID_ART_PROVIDER=
FAL_KEY=

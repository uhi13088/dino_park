{
  "name": "dino-park-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Dino Park Tycoon - A tycoon/idle game for Toss Apps",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:client": "turbo run dev --filter=@dino-park/client",
    "dev:server": "turbo run dev --filter=@dino-park/server",
    "build:client": "turbo run build --filter=@dino-park/client",
    "build:server": "turbo run build --filter=@dino-park/server"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

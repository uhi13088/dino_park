{
  "name": "dino-park-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Dino Park Tycoon - A tycoon/idle game for Toss Apps",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:client": "turbo run dev --filter=@dino-park/client",
    "dev:server": "turbo run dev --filter=@dino-park/server",
    "build:client": "turbo run build --filter=@dino-park/client",
    "build:server": "turbo run build --filter=@dino-park/server",
    "db:dev": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "prisma:generate": "pnpm --filter @dino-park/server prisma:generate",
    "prisma:migrate": "pnpm --filter @dino-park/server prisma:migrate",
    "prisma:studio": "pnpm --filter @dino-park/server prisma:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

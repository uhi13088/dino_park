# ==============================================
# 다이노 파크 타이쿤 - 환경 변수 템플릿
# 이 파일을 .env.local로 복사하여 사용하세요
# ==============================================

# 앱 설정
NODE_ENV=development

# 데이터베이스 (Docker Compose 기본값)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dino_park?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT 설정
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# 서버 설정
SERVER_PORT=4000
CLIENT_PORT=3000

# CORS
CORS_ORIGIN=http://localhost:3000

# 토스 앱스 연동 (Phase 6에서 설정)
# TOSS_CLIENT_ID=
# TOSS_CLIENT_SECRET=
# TOSS_REDIRECT_URI=
